RewriteEngine On
RewriteBase /

# http -> https, non-www -> www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.flatpackco.com%{REQUEST_URI} [L,R=301]

# /index and /index.html -> /
# Matches against THE_REQUEST (what the browser actually asked for) so the
# internal DirectoryIndex lookup of index.html for "/" doesn't trigger a loop.
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [L,R=301]

# Removed scripts: deployment only copies files, so copies can remain on the
# server after being deleted from the repo. Keep them unreachable.
RewriteRule ^(test-mail|send-mail)\.php$ - [G,L,NC]
RewriteRule ^phpmailer(/|$) - [F,L,NC]
RewriteRule ^main\.js$ - [G,L,NC]

# Project removed from the site: send old links to the portfolio and keep its
# images unreachable, since deployment doesn't delete copies from the server.
RewriteRule ^uttham-midway-lounge-sonipat(\.html)?$ /work [R=301,L,NC]
RewriteRule ^images/projects/uttham-midway-lounge-sonipat/ - [G,L,NC]

# Old project-page URLs -> new consistent lowercase-hyphenated slugs
# NOTE: the Naaivedh rule is intentionally case-sensitive (no NC flag).
# The only difference between the old and new URL is letter case, so
# a case-insensitive match here would also match the new URL itself
# and create an infinite redirect loop.
RewriteRule ^the_beer_cafe\.html$ /the-beer-cafe-restaurant-fit-out [R=301,L,NC]
RewriteRule ^Naaivedh\.html$ /naaivedh-sweet-shop-design-and-build [R=301,L]
RewriteRule ^poie-and-co\.html$ /poee-and-co-goa-bar-fit-out [R=301,L,NC]

# Old pages with no matching file -> current pages
RewriteRule ^about\.html$ /about-us [R=301,L,NC]
RewriteRule ^contact\.html$ /contact-us [R=301,L,NC]
RewriteRule ^talk-to-us/?$ /contact-us [R=301,L,NC]
RewriteRule ^Projects_new\.html$ /work [R=301,L,NC]

# Old /post/<slug> blog URLs -> /<slug>
RewriteRule ^post/(.+)$ /$1 [R=301,L,NC]

# Old URLs -> new URLs
Redirect 301 /search https://www.flatpackco.com/blogs
Redirect 301 /aboutus https://www.flatpackco.com/about-us
RewriteRule ^panelling\.html$ /restaurant-cafe-wall-panelling [R=301,L,NC]
RewriteRule ^design-ceilings\.html$ /ceiling-design-for-bars-restaurants [R=301,L,NC]
RewriteRule ^movable-furniture\.html$ /movable-furniture-for-restaurant-cafe [R=301,L,NC]
RewriteRule ^floors-walls\.html$ /floor-wall-solutions [R=301,L,NC]
RewriteRule ^kiosk\.html$ /kiosk-design-and-build-services [R=301,L,NC]
RewriteRule ^facade\.html$ /facade-design-restaurant [R=301,L,NC]
RewriteRule ^fa%C3%A7ade-design\.html$ /facade-design-restaurant [R=301,L,NC]
RewriteRule ^commercial-kitchen\.html$ /commercial-kitchen-equipment-for-restaurant-and-bar [R=301,L,NC]
RewriteRule ^lighting\.html$ /lighting-design-for-commercial-spaces [R=301,L,NC]
RewriteRule ^the-beer-cafe\.html$ /the-beer-cafe-restaurant-fit-out [R=301,L,NC]
RewriteRule ^social-e-city\.html$ /social-e-city-bangalore-design-and-build [R=301,L,NC]
RewriteRule ^poee-and-co\.html$ /poee-and-co-goa-bar-fit-out [R=301,L,NC]
RewriteRule ^harvest-salad-co\.html$ /harvest-salad-co-qsr-design [R=301,L,NC]
RewriteRule ^sangeetha-restaurant\.html$ /sangeetha-restaurant-restaurant-fit-out [R=301,L,NC]
RewriteRule ^amoeba-sports-bar\.html$ /amoeba-sports-bar-design-and-build [R=301,L,NC]
RewriteRule ^naaivedh\.html$ /naaivedh-sweet-shop-design-and-build [R=301,L,NC]
RewriteRule ^amoeba-sports-bar-design-and-build-solutions\.html$ /amoeba-sports-bar-design-and-build [R=301,L,NC]
RewriteRule ^poee-and-co-goa-bar-fit-out-solutions\.html$ /poee-and-co-goa-bar-fit-out [R=301,L,NC]
RewriteRule ^social-e-city-bangalore-design-build-solutions\.html$ /social-e-city-bangalore-design-and-build [R=301,L,NC]
RewriteRule ^naaivedh-sweet-shop-design-build\.html$ /naaivedh-sweet-shop-design-and-build [R=301,L,NC]

# Hide .html extension: if a browser directly requests a *.html URL,
# send it to the extension-less version so the address bar never shows .html
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the matching .html file for the extension-less URL
# (the browser URL is left untouched)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
